# Ghostty terminal configuration
# Installed to ~/.config/ghostty/config
# Reference: https://ghostty.org/docs/config/reference
#
# Managed by penguin_setup: this file is overwritten by `sync.sh pull`.
# Ghostty reloads config with cmd/ctrl+shift+comma.

# Machine-local overrides. The leading ? makes the include optional, so this
# is a no-op when the file does not exist. Put anything platform- or
# host-specific there rather than editing this file -- it survives a pull.
config-file = ?"~/.config/ghostty/config.local"

# Font. The NL variant is "no ligatures"; the Nerd Font build supplies the
# glyphs that eza, lazygit and fastfetch draw with.
font-family = "JetBrainsMonoNL Nerd Font"
font-style = Regular
font-size = 9

# Window
window-theme = ghostty          # follow ghostty's own light/dark, not the OS
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false   # no prompt when closing a split or tab
resize-overlay = never          # hide the size indicator while dragging

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# GTK-only settings live in config.local on Linux, since ghostty on macOS
# does not recognise them:
#   gtk-toolbar-style = flat
#   async-backend = epoll   # works around slow rendering under Wayland
#                           # https://github.com/ghostty-org/ghostty/discussions/3224
